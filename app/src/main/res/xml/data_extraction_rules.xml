<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup and device-to-device transfer on Android 12+ (backup_rules.xml covers
   Android 11 and lower). The WebView's data directory holds the Facebook
   session (cookies) and web storage, so it is excluded from both: a restored or
   transferred install logs in again. App settings (DataStore) are kept.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="app_webview/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="app_webview/" />
    </device-transfer>
</data-extraction-rules>
