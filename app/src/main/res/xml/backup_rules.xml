<?xml version="1.0" encoding="utf-8"?>
<!--
   Auto Backup on Android 11 and lower (Android 12+ reads data_extraction_rules.xml).
   Everything is backed up except the WebView's data directory, which holds the
   Facebook session (cookies) and web storage: a backup or a restore to another
   phone must never carry a logged-in session. App settings (DataStore) are kept.
-->
<full-backup-content>
    <exclude domain="root" path="app_webview/" />
</full-backup-content>
