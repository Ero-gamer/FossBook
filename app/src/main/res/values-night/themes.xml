<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- A dark parent in night mode: the WebView takes prefers-color-scheme from the app
         theme, so a light parent here kept Facebook light in dark mode. -->
    <style name="Theme.Astryxbook" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/background_dark</item>
        <item name="android:colorControlActivated">#1877F2</item>
    </style>
</resources>